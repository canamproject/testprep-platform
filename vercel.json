{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "echo skip",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://testprep-platform-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!manifest\\.json|sw\\.js|favicon\\.svg|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
